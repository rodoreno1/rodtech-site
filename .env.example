# Copia este archivo como .env para probar en local (npm run dev).
# En Vercel estas variables se definen en Settings → Environment Variables.

# Contraseña del panel /admin (obligatoria en Vercel; en local, si falta, es "admin")
ADMIN_PASSWORD=

# URL de Postgres. En Vercel la pone sola la integración de Neon.
# En local puedes dejarla vacía: se usa un Postgres embebido en .data/
DATABASE_URL=
